{
  "name": "@arpitnath/doubt",
  "version": "0.1.0",
  "description": "A reading tool for PRs at agent volume: one chunk at a time, understood or doubt.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "doubt": "dist/daemon/server.js"
  },
  "files": [
    "dist",
    "ui/dist",
    "README.md",
    "GUIDE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitnath/doubt.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch daemon/server.ts",
    "start": "tsx daemon/server.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "spike": "tsx spike/sdk.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsx daemon/lang.check.ts",
    "build": "npm run ui:build && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "node-pty": "^1.1.0",
    "ts5": "npm:typescript@^5.9.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.5.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
